{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<UME_HARNESS_INSTALL_DIR>/adapters/claude-code/pretooluse_hook.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<UME_HARNESS_INSTALL_DIR>/adapters/claude-code/permission_request_hook.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<UME_HARNESS_INSTALL_DIR>/adapters/claude-code/posttooluse_failure_hook.py"
          }
        ]
      }
    ]
  }
}
